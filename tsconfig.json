{
  "compilerOptions": {
    "module": "nodenext",
    "target": "esnext",
    "outDir": "./dist",
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@chocolux/shared/types": ["../shared/types/index.ts"],
      "@chocolux/shared/*": ["../shared/*"],
      "@shared/*": ["../shared/*"]
    },
    "moduleDetection": "force",
    "skipLibCheck": true
  },
  "include": ["src"],
  "references": [
    { "path": "../shared" }
  ]
}

